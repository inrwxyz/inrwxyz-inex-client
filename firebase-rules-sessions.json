{
  "sessions": {
    "$code": {
      ".read": true,
      ".write": true,
      ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{8}$/)",
      "meta": {
        ".validate": "newData.hasChildren(['exp']) && newData.child('exp').isNumber()"
      },
      "toHost": {
        "$sid": {
          ".validate": "$sid.matches(/^[a-z0-9]{6,20}$/)",
          "$mid": {
            ".validate": "newData.hasChildren(['d'])",
            "d": { ".validate": "newData.isString() && newData.val().length < 20000" },
            "t": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      },
      "toFriend": {
        "$sid": {
          ".validate": "$sid.matches(/^[a-z0-9]{6,20}$/)",
          "$mid": {
            ".validate": "newData.hasChildren(['d'])",
            "d": { ".validate": "newData.isString() && newData.val().length < 20000" },
            "t": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      },
      "$other": { ".validate": false }
    }
  }
}
