{
  "name": "inex-client",
  "version": "1.0.0",
  "description": "INEX CLIENT — Premium Black & Crimson Windows Minecraft Launcher with Profile Management & Modrinth Content Browser",
  "main": "main.js",
  "author": "INEX Studios",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/test-backend.js",
    "build:win": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64",
    "embed-logo": "node scripts/embed-logo.js",
    "prestart": "node scripts/embed-logo.js",
    "predev": "node scripts/embed-logo.js",
    "prebuild:win": "node scripts/embed-logo.js && node scripts/make-icon.js",
    "prebuild:portable": "node scripts/embed-logo.js && node scripts/make-icon.js",
    "make-icon": "node scripts/make-icon.js"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.inexclient.launcher",
    "productName": "INEX CLIENT",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "INEX CLIENT"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
